# Optional local testing environment template. PHPUnit already sets in-memory SQLite and array drivers.
# Copy to .env.testing only when a local override is required; generate any APP_KEY locally.
APP_ENV=testing
APP_KEY=
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=4
MAIL_MAILER=array
